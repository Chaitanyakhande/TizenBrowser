{
  "name": "tizenbrowser",
  "version": "0.1.0",
  "description": "Remote-first TizenBrew browser module with built-in ad and tracker blocking.",
  "packageType": "app",
  "appName": "TizenBrowser",
  "appPath": "app/index.html",
  "evaluateScriptOnDocumentStart": false,
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious"
  ],
  "files": [
    "app",
    "src",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "tizen",
    "tizen-tv",
    "tizenbrew",
    "browser",
    "adblock",
    "privacy"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node --check src/tizenbrowser.js"
  }
}
